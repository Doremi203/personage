@startuml Notificator Service Architecture (landscape)

skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam linetype polyline
skinparam ranksep 40
skinparam nodesep 20
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
left to right direction

skinparam component {
    BackgroundColor<<external>> #FFE6E6
    BorderColor<<external>>     #CC0000
    BackgroundColor<<api>>      #DCEEFB
    BorderColor<<api>>          #2277BB
    BackgroundColor<<worker>>   #E6F3FF
    BorderColor<<worker>>       #0066CC
    BackgroundColor<<usecase>>  #E6FFE6
    BorderColor<<usecase>>      #00AA00
    BackgroundColor<<service>>  #FFF4E6
    BorderColor<<service>>      #FF8C00
    BackgroundColor<<repo>>     #F0E6FF
    BorderColor<<repo>>         #6600CC
    BackgroundColor<<infra>>    #ECECEC
    BorderColor<<infra>>        #555555
    BackgroundColor<<storage>>  #E6E6E6
    BorderColor<<storage>>      #666666
}

' ───────── Внешние источники (входы) ─────────
package "Внешние источники" as ext_in {
    component "Frontend / PWA"             as clients <<external>>
    component "YMQ\nNotificator commands"  as q_in    <<external>>

    clients -[hidden]down- q_in
}

' ───────── API + точки входа ─────────
package "API и точки входа" as entry {
    component "Push Subscription gRPC\n+ SubscribeV1\n+ UnsubscribeV1" as subscription_grpc <<api>>
    component "Notifications gRPC\n+ ListNotificationsV1\n+ GetNotificationSettingsV1\n+ ToggleNotificationV1\n+ MarkNotificationAsReadV1\n+ MarkAllNotificationsAsReadV1" as notifications_grpc <<api>>
    component "Admin gRPC\n(API-key)\n+ SendPushV1"             as admin_grpc      <<api>>
    component "SQS Message Processor\n+ Notification Handler"  as sqs_proc        <<worker>>
    component "Notification Retrier\n(планировщик)"             as retrier_worker  <<worker>>

    subscription_grpc  -[hidden]down- notifications_grpc
    notifications_grpc -[hidden]down- admin_grpc
    admin_grpc         -[hidden]down- sqs_proc
    sqs_proc           -[hidden]down- retrier_worker
}

' ───────── Use Cases ─────────
package "Use Cases" as uc_pkg {
    component "Push Subscription UseCase\n+ Subscribe\n+ Unsubscribe\n+ GetRecipient" as push_subscription_uc <<usecase>>
    component "Push Sender UseCase\n+ Send"                                            as push_sender_uc       <<usecase>>
    component "Notifications UseCase\n+ List / GetSettings\n+ MarkAsRead / MarkAllAsRead\n+ Toggle" as notifications_uc <<usecase>>

    push_subscription_uc -[hidden]down- push_sender_uc
    push_sender_uc       -[hidden]down- notifications_uc
}

' ───────── Services ─────────
package "Services" as svc_pkg {
    component "Rate Limiter\n+ Allow" as rate_limiter <<service>>
}

' ───────── Repositories ─────────
package "Repositories" as repo_pkg {
    component "Push Repository\n+ UpsertSubscription\n+ DeleteSubscription\n+ GetSubscriptionsByRecipientID\n+ GetAllRecipients" as push_repo <<repo>>
    component "Notification Repository\n+ Create / CreateIfAbsent / CreateAndReturnID\n+ ListByUserID / ListPending\n+ MarkAsRead / MarkAllAsRead / MarkSent\n+ UpdateRetryAfter / CountSentSince / Drop\n+ GetSettings / IsSettingEnabled / ToggleSetting" as notification_repo <<repo>>

    push_repo -[hidden]down- notification_repo
}

' ───────── Инфраструктура и хранилище ─────────
package "Инфраструктура" as infra {
    component "Database Client\n(pgxpool)" as db_client <<infra>>
}

database "PostgreSQL\npush_subscriptions\nnotifications\nnotification_settings" as postgres <<storage>>

' ───────── Внешние интеграции (выходы) ─────────
package "Внешние интеграции" as ext_out {
    component "Web Push Service\n(VAPID, FCM / autopush)" as webpush <<external>>
}

' ───────── Связи ─────────
clients --> subscription_grpc  : gRPC / HTTP
clients --> notifications_grpc : gRPC / HTTP
clients --> admin_grpc         : gRPC (API-key)
q_in    --> sqs_proc

subscription_grpc  --> push_subscription_uc
notifications_grpc --> notifications_uc
admin_grpc         --> push_sender_uc
admin_grpc         --> push_repo

sqs_proc       --> push_sender_uc
sqs_proc       --> push_subscription_uc
sqs_proc       --> notification_repo
sqs_proc       --> rate_limiter

retrier_worker --> notification_repo
retrier_worker --> push_sender_uc
retrier_worker --> push_subscription_uc
retrier_worker --> rate_limiter

push_subscription_uc --> push_repo
push_sender_uc       --> push_repo
push_sender_uc       --> webpush
notifications_uc     --> notification_repo

rate_limiter --> notification_repo

push_repo         --> db_client
notification_repo --> db_client
db_client         --> postgres

@enduml
