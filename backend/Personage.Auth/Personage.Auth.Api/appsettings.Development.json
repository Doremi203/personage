{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true,
    "RoutePrefix": "swagger"
  },
  "YandexCloud" : {
    "UseMetadataService": false
  },
  "TelegramAuthGrpcSettings": {
    "Url": "http://localhost:50061",
    "TimeoutSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:5254",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:3000"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS",
      "PATCH"
    ],
    "AllowedHeaders": [
      "*"
    ],
    "AllowCredentials": true,
    "ExposedHeaders": [
      "Content-Disposition"
    ]
  }
}
