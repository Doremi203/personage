        </mxCell>
        <mxCell id="pkg_tasks" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;dashed=1;dashPattern=4 3;fontStyle=1;fontSize=11;fillColor=none;strokeColor=#888888;" value="Управление задачами" vertex="1">
