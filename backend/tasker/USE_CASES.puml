@startuml
' Personage — Infrastructure / Deployment diagram
skinparam shadowing false
skinparam defaultFontName Arial

actor "Пользователь" as User

node "Клиентские устройства" as ClientDevices {
  component "Web браузер (PWA)" as WebClient
}

cloud "LLM Provider" as LLMCloud {
  component "OpenRouter API" as LLMAPI
}
cloud "Web Push" as PushCloud {
  component "FCM / Mozilla autopush" as PushAPI
}

node "Облачная инфраструктура (Yandex Cloud)" as CloudEnv {

  node "DNS" as dns {
    component "ANAME запись\npersomanage.ru" as dns_apex
    component "L7 запись\n*.persomanage.ru\ngrpc-*.persomanage.ru" as dns_l7
  }

  node "L7 балансировщик" as l7 {
    component "HTTPS слушатель (443)" as l7_https
    component "HTTP слушатель (80)\nперенаправляет на HTTPS" as l7_http
    component "HTTPS router" as l7_router

    component "Tasker виртуальный хост\ntasker.persomanage.ru\ngrpc-tasker.persomanage.ru" as vh_tasker
    component "Auth виртуальный хост\nauth.persomanage.ru\ngrpc-auth.persomanage.ru" as vh_auth
    component "Notificator виртуальный хост\nnotificator.persomanage.ru\ngrpc-notificator.persomanage.ru" as vh_notif
    component "Telegram-auth виртуальный хост\ntelegram-auth.persomanage.ru\ngrpc-telegram-auth.persomanage.ru" as vh_tgauth
    component "Traitex виртуальный хост\ntraitex.persomanage.ru\ngrpc-traitex.persomanage.ru" as vh_traitex
  }

  node "Tasker группа ВМ" as tasker_ig {
    component "node 1" as tasker_n1
    component "node 2" as tasker_n2
  }
  node "Auth группа ВМ" as auth_ig {
    component "node 1" as auth_n1
    component "node 2" as auth_n2
  }
  node "Notificator группа ВМ" as notif_ig {
    component "node 1" as notif_n1
    component "node 2" as notif_n2
  }
  node "Telegram-auth группа ВМ" as tgauth_ig {
    component "node 1" as tgauth_n1
    component "node 2" as tgauth_n2
  }
  node "Traitex группа ВМ" as traitex_ig {
    component "node 1" as traitex_n1
    component "node 2" as traitex_n2
  }

  queue "Connector events YMQ" as q_connector
  queue "Notificator commands YMQ" as q_notificator
  queue "Tasker eval events YMQ" as q_eval

  database "PostgreSQL\n(pgvector)" as PG
  database "Valkey (Redis)\n+ Sentinel" as Valkey

  component "CDN" as cdn
  database "Frontend S3\nстатические файлы" as s3_front
}

User --> WebClient
WebClient --> dns : HTTPS/HTTP\n*.persomanage.ru

dns_apex --> cdn : persomanage.ru
dns_l7 --> l7_https : HTTPS\n*.persomanage.ru
dns_l7 --> l7_http : HTTP\n*.persomanage.ru
cdn --> s3_front : Кэширует статику

l7_https --> l7_router
l7_router --> vh_tasker : tasker.persomanage.ru/*
l7_router --> vh_auth : auth.persomanage.ru/*
l7_router --> vh_notif : notificator.persomanage.ru/*
l7_router --> vh_tgauth : telegram-auth.persomanage.ru/*
l7_router --> vh_traitex : traitex.persomanage.ru/*

vh_tasker --> tasker_ig
vh_auth --> auth_ig
vh_notif --> notif_ig
vh_tgauth --> tgauth_ig
vh_traitex --> traitex_ig

tasker_ig --> auth_ig : GRPC
notif_ig --> auth_ig : GRPC
traitex_ig --> auth_ig : GRPC
tgauth_ig --> auth_ig : GRPC

traitex_ig --> q_connector : Запись событий
q_connector --> tasker_ig : Чтение событий
tasker_ig --> q_notificator : Запись событий
q_notificator --> notif_ig : Чтение событий
tasker_ig --> q_eval : Чтение/запись событий

tasker_ig --> PG : SQL
auth_ig --> PG : SQL
notif_ig --> PG : SQL
traitex_ig --> PG : SQL
tgauth_ig --> Valkey : Redis Sentinel

tasker_ig --> LLMAPI : Запросы к LLM
notif_ig --> PushAPI : Web Push (VAPID)

@enduml
