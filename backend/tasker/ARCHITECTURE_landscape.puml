@startuml Tasker Service Architecture (landscape)

skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam linetype polyline
skinparam ranksep 35
skinparam nodesep 18
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
left to right direction

skinparam component {
    BackgroundColor<<external>> #FFE6E6
    BorderColor<<external>>     #CC0000
    BackgroundColor<<api>>      #DCEEFB
    BorderColor<<api>>          #2277BB
    BackgroundColor<<worker>>   #E6F3FF
    BorderColor<<worker>>       #0066CC
    BackgroundColor<<usecase>>  #E6FFE6
    BorderColor<<usecase>>      #00AA00
    BackgroundColor<<service>>  #FFF4E6
    BorderColor<<service>>      #FF8C00
    BackgroundColor<<repo>>     #F0E6FF
    BorderColor<<repo>>         #6600CC
    BackgroundColor<<infra>>    #ECECEC
    BorderColor<<infra>>        #555555
    BackgroundColor<<storage>>  #E6E6E6
    BorderColor<<storage>>      #666666
}

' Каждый «слой» — вертикальный столбец, слои выстроены слева направо.

' ───────── Внешние источники (входы) ─────────
package "Внешние источники" as ext_in {
    component "Frontend / PWA"          as clients <<external>>
    component "YMQ\nConnector Events"   as q_in    <<external>>

    clients -[hidden]down- q_in
}

' ───────── API + точки входа ─────────
package "API и точки входа" as entry {
    component "Tasks gRPC Service\n+ ListTasksV1\n+ GetTaskV1\n+ UpdateTaskV1\n+ PostponeTaskV1\n+ CompleteTaskV1\n+ DeleteTaskV1" as grpc_tasks <<api>>
    component "SQS Message Processor\n+ Connector Events Handler" as sqs_proc <<worker>>
    component "Cluster Closure Worker\n(планировщик)"  as closure_worker      <<worker>>
    component "Scheduling Worker\n(планировщик)"       as scheduling_worker   <<worker>>
    component "Notification Worker\n(планировщик)"     as notification_worker <<worker>>

    grpc_tasks        -[hidden]down- sqs_proc
    sqs_proc          -[hidden]down- closure_worker
    closure_worker    -[hidden]down- scheduling_worker
    scheduling_worker -[hidden]down- notification_worker
}

' ───────── Use Cases ─────────
package "Use Cases" as uc_pkg {
    component "Clusterization UseCase\n+ ProcessEvent"               as clusterization_uc <<usecase>>
    component "Task Generation UseCase\n+ ProcessClosableClusters"   as taskgen_uc        <<usecase>>
    component "Scheduling UseCase\n+ SchedulePendingTasks"           as scheduling_uc     <<usecase>>
    component "Task List UseCase\n+ GetTasks / GetTask\n+ UpdateTask / PostponeTask\n+ CompleteTask / DeleteTask" as tasklist_uc <<usecase>>

    clusterization_uc -[hidden]down- taskgen_uc
    taskgen_uc        -[hidden]down- scheduling_uc
    scheduling_uc     -[hidden]down- tasklist_uc
}

' ───────── Services ─────────
package "Services" as svc_pkg {
    component "Embedding Service\n+ GenerateEmbeddings"                 as embedding_service        <<service>>
    component "Cluster Actionability Service\n+ GetTaskGenerationDecision" as actionability_service <<service>>
    component "Task Generation Service\n+ GenerateTask"                 as task_service             <<service>>
    component "Scheduler (pure)\n+ CalculateSchedule"                   as scheduler_service        <<service>>
    component "Upcoming Event Notifier\n+ NotifyUpcomingEvents"         as upcoming_notifier        <<service>>
    component "Schedule Change Notifier\n+ NotifyScheduleChanges"       as schedule_change_notifier <<service>>
    component "Notificator Push Service\n+ Send"                        as notificator_push         <<service>>

    embedding_service        -[hidden]down- actionability_service
    actionability_service    -[hidden]down- task_service
    task_service             -[hidden]down- scheduler_service
    scheduler_service        -[hidden]down- upcoming_notifier
    upcoming_notifier        -[hidden]down- schedule_change_notifier
    schedule_change_notifier -[hidden]down- notificator_push
}

' ───────── Repositories ─────────
package "Repositories" as repo_pkg {
    component "Event Repository\n+ UpsertEvent\n+ GetEventsByClusterID\n+ DeleteEventsByClusterID" as event_repo <<repo>>
    component "Cluster Repository\n+ FindSimilarClusters\n+ UpsertCluster\n+ FindClosableClusters\n+ UpdateClusterStatus\n+ FinalizeCluster\n+ RecoverStaleClusters\n+ DeleteCluster" as cluster_repo <<repo>>
    component "Task Repository\n+ CreateTask / GetTaskByID\n+ ListTasks\n+ GetTasksByUserID / Status\n+ GetUsersWithUnplannedTasks\n+ UpdateTask / Schedule / Status\n+ DeleteTask" as task_repo <<repo>>

    event_repo   -[hidden]down- cluster_repo
    cluster_repo -[hidden]down- task_repo
}

' ───────── Инфраструктура и хранилище ─────────
package "Инфраструктура" as infra {
    component "Database Client\n(pgxpool + pgvector)" as db_client   <<infra>>
    component "Tx Provider"                            as tx_provider <<infra>>

    db_client -[hidden]down- tx_provider
}

database "PostgreSQL\n+ pgvector" as postgres <<storage>>

' ───────── Внешние интеграции (выходы) ─────────
package "Внешние интеграции" as ext_out {
    component "OpenRouter API\n(LLM + Embeddings)" as openrouter <<external>>
    component "YMQ\nNotificator commands"         as q_out      <<external>>

    openrouter -[hidden]down- q_out
}

' ───────── Связи: входящие потоки ─────────
clients --> grpc_tasks : gRPC / HTTP
q_in --> sqs_proc

grpc_tasks         --> tasklist_uc
sqs_proc           --> clusterization_uc
closure_worker     --> taskgen_uc
scheduling_worker  --> scheduling_uc
notification_worker --> upcoming_notifier
notification_worker --> schedule_change_notifier
notification_worker --> task_repo

' ───────── Use Cases → Services / Repositories ─────────
clusterization_uc --> embedding_service
clusterization_uc --> cluster_repo
clusterization_uc --> event_repo

taskgen_uc --> actionability_service
taskgen_uc --> task_service
taskgen_uc --> cluster_repo
taskgen_uc --> event_repo
taskgen_uc --> task_repo

scheduling_uc --> task_repo
scheduling_uc ..> scheduler_service : pure call
scheduling_uc --> notificator_push

tasklist_uc --> task_repo
tasklist_uc --> event_repo
tasklist_uc --> cluster_repo
tasklist_uc --> tx_provider

' ───────── Services → внешний LLM / очередь ─────────
embedding_service     --> openrouter
actionability_service --> openrouter
task_service          --> openrouter

upcoming_notifier        --> notificator_push
schedule_change_notifier --> notificator_push
notificator_push --> q_out

' ───────── Repositories / Tx → DB Client → PostgreSQL ─────────
event_repo   --> db_client
cluster_repo --> db_client
task_repo    --> db_client
tx_provider  --> db_client
db_client    --> postgres

@enduml
