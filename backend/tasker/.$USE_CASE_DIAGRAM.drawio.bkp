        <mxCell id="uc1" value="1. Подключить Gmail&#10;(OAuth)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DCE8F5;strokeColor=#4F7AAE;strokeWidth=1.2;" vertex="1" parent="1">
